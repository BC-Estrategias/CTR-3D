; CTR-Native PICA200 vertex shader -- native MODEL renderer, rung 2.
; docs/NATIVE_MODEL_RENDERER_DESIGN.md sections 4 and 7.
;
; Third vertex program in the build, after ctr.v.pica (packet path: remaps
; already-CPU-projected screen positions through an ortho matrix) and
; ctr_track.v.pica (resident track: real perspective camera, model-space input).
; This one is the track shader's shape applied per INSTANCE instead of per
; camera, with the ordinal machinery deleted.
;
; ---------------------------------------------------------------- projection
;
; Input is a model-space vertex exactly as the software GTE would have received
; it (platform/native_model_emit.c takes it straight from the GTE's own V
; register pair, so the numbers are provably the same ones the packet path
; projected). qx/qy/qw are composed on the CPU per instance from idpp->mvp --
; the instance's model->VIEW matrix -- plus the camera's H/OFX/OFY, by the same
; derivation ctr_track.v.pica documents:
;
;   view.x = (R00*vx + R01*vy + R02*vz)/4096 + TRX   (same shape for y/z)
;   screenX = OFX + H * view.x / view.z
;
;   qx = [ R00/4096 + (OFX/H)*R20/4096, ..., TRX + (OFX/H)*TRZ ]
;   qy = [ R10/4096 + (OFY/H)*R20/4096, ..., TRY + (OFY/H)*TRZ ]
;   qw = [ R20/(4096*H), R21/(4096*H), R22/(4096*H), TRZ/H ]
;
; so dp4 against raw model-space (vx,vy,vz,1) yields w*screenX, w*screenY and
; w = view.z/H with no per-vertex divide. The GPU's own perspective divide then
; produces the real screen position.
;
; The ONLY difference from the track's composition is which matrix goes in:
; the track feeds pushBuffer->matrix_ViewProj (world->view), this feeds
; idpp->mvp (model->view). Same units, same GTE, same axis -- which is the
; whole point (see DEPTH below).
;
; ------------------------------------------------------------------- depth
;
; depth = view.z, clamped to [256, 65535]; zOrd = 32767 - depth.
;
; That expression is NOT a free choice and must not be "simplified". Packets
; stamp 0xFFFF - maxSz3 and N3DS_Vertex maps z = value - 32768, so a packet at
; depth d lands at 32767 - d. ctr_track.v.pica's TRUE DEPTH path uses the
; identical expression. Three geometry sources, one axis. Change one, and the
; sources sit on parallel-but-offset axes -- which looks correct while parked
; and wrong in motion, the failure mode that cost s28 and s29 a session each.
;
; The 256 floor is the shared near band: native_gpu.c reserves stamps
; 0xFF00..0xFFFF for depthless 2D/UI that must sit in front of all world
; content, and clamps world content to 0xFEFF. 0xFEFF - 32768 = 32511 is the
; nearest zOrd world geometry may produce, i.e. depth may not fall below 256.
; If PKTDEPTH_UI_BAND changes in native_gpu.c, this and ctr_track.v.pica must
; both change with it.
;
; NO drawOrder term. drawOrder is a QuadBlock field; nothing under Vehicle/ has
; one, and packets carry none. The track shader keeps a 1.0-unit tie-break only
; to order road decals against the road; a model has nothing to tie-break
; against, and s29 established on hardware what a too-large term does here (it
; buried the player kart to the neck).
;
; NO per-leaf ordinal lerp, no depthRange uniform, no near-plane reject. The
; track carries those because its geometry is bucketed per BSP leaf and its
; visibility is leaf-granular. A model instance is one object with one matrix.
;
; -------------------------------------------------------- uniform registers
;
; projection[4] IS DECLARED FIRST, DELIBERATELY.
;
; PICA200 uniform names are not per-program handles -- they are offsets into
; one physical register file shared by every vertex program. ctr.v.pica
; declares projection[4] first, so it lands on f0-f3. Declaring anything ahead
; of projection here would put this program's own uniforms on those same
; registers and silently destroy the packet path's projection matrix.
;
; That is not hypothetical: it is exactly the s29 bug. ctr_track.v.pica puts
; qx/qy/qw on f0-f2, every track draw overwrote ctr.v.pica's projection, and
; every packet drawn afterwards died -- which under DRAW_MERGE is all of them.
; The fix was to re-upload the packet projection on every bind. This program
; avoids needing that fix by matching ctr.v.pica's layout instead.
.fvec projection[4] ; f0-f3 -- SAME registers ctr.v.pica uses. Keep it first.
.fvec qx            ; f4 -- composed instance row: dp4(qx, v) = w*screenX
.fvec qy            ; f5 -- composed instance row: dp4(qy, v) = w*screenY
.fvec qw            ; f6 -- composed instance row: dp4(qw, v) = w = view.z/H
.fvec hParam        ; f7 -- x = H (distanceToScreen_PREV); y/z/w unused

; Constants
.constf constants(0.0, 1.0, -1.0, 0.0)
.alias  zeros constants.xxxx
.alias  ones  constants.yyyy

; x = 1/2048 -- texcoord scale. Model UVs are written by the CPU in the PACKET
;     path's atlas convention (2*texel + 1, V pre-flipped as 2047 - 2a) against
;     the 1024-wide decode-cache atlases, so the divisor is 2*1024. Identical to
;     ctr.v.pica's texcoordScale, because model textures resolve through the
;     same decode cache -- NOT the track's own 512 atlas, whose scale is 1/1024.
;     Getting this wrong halves or doubles every model texture.
; y = 1/255 -- colour rescale from the raw GPU_UNSIGNED_BYTE fetch.
; z = 65535 -- SZ3's clamp ceiling (native_gte_core.c's Lm_D), so model depth
;     saturates exactly where packet sz3 saturates.
; w = -1 -- negation for subtraction (PICA200 has no SUB opcode; verified
;     against picasso's own mnemonic list).
.constf modelConst(0.00048828125, 0.0039215686, 65535.0, -1.0)
.alias  texcoordScale modelConst.xxxx
.alias  colorScale    modelConst.yyyy
.alias  depthMax      modelConst.zzzz
.alias  negOne        modelConst.wwww

; x = 256 -- the world near-band floor described above.
; y = 32767 -- zOrd = 32767 - depth.
.constf depthConst(256.0, 32767.0, 0.0, 0.0)
.alias  depthMinWorld depthConst.xxxx
.alias  zOrdFromDepth depthConst.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs -- regId order must match the model attribute layout set up in
; n3ds_backend.c, the same way ctr.v.pica's matches s_attrInfo.
.alias inpos v0 ; x, y, z -- model space, raw GTE units (NOT rescaled: qx/qy/qw
                 ; already fold the /4096 rotation scale)
.alias intc  v1 ; u, v -- atlas texel numerators, packet-path convention
.alias inclr v2 ; r, g, b

.proc main
	; r0 = (vx, vy, vz, 1) -- raw model-space position, homogeneous.
	mov r0.xyz, inpos.xyz
	mov r0.w, ones

	; a = w*screenX, b = w*screenY, w = view.z/H. Constant/uniform operand
	; FIRST (src1), temp register second (src2) -- PICA200's src2 cannot
	; address the constant/uniform bank. Same restriction both other programs
	; document; violating it assembles and then misbehaves.
	dp4 r1.x, qx, r0
	dp4 r1.y, qy, r0
	dp4 r1.z, qw, r0

	; viewZ = w * H -- recovers retail's SZ3/maxDepth axis directly. This is
	; R2.v/4096 + TRZ, NOT a reciprocal depth (native_gte_core.c:319-328).
	mul r2.x, hParam, r1.z

	; depth = clamp(viewZ, 256, 65535); zOrd = 32767 - depth.
	max r2.y, depthMinWorld, r2.x
	min r2.y, depthMax, r2.y
	mul r2.z, negOne, r2.y              ; -depth (no SUB opcode)
	add r2.w, zOrdFromDepth, r2.z       ; zOrd

	; S = (a, b, w*zOrd, w). Assembled component-by-component: a single mov
	; reads ONE source register, so gathering four components from three temps
	; takes four movs.
	mul r3.x, r1.z, r2.w                ; w*zOrd (both temps, order-free)
	mov r4.x, r1.x                      ; a
	mov r4.y, r1.y                      ; b
	mov r4.z, r3.x                      ; w*zOrd
	mov r4.w, r1.z                      ; w

	; outpos = projection * S. Mtx_OrthoTilt's row 3 is (0,0,0,1), so outpos.w
	; comes out equal to S.w = w, which is what the GPU's perspective divide
	; needs. Both other programs already depend on that property every frame on
	; real hardware -- see ctr_track.v.pica's header for the full argument.
	dp4 outpos.x, projection[0], r4
	dp4 outpos.y, projection[1], r4
	dp4 outpos.z, projection[2], r4
	dp4 outpos.w, projection[3], r4

	; Every declared output component must be written -- the s14 hardware boot
	; hang, which Azahar does not reproduce. z/w get explicit zeros.
	mul outtc0.xy, texcoordScale, intc.xy
	mov outtc0.zw, zeros

	mul outclr.xyz, colorScale, inclr.xyz
	mov outclr.w, ones

	end
.end
