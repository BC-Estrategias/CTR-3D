; CTR-Native PICA200 vertex shader -- phase 2a (static/opaque geometry, mono).
;
; Positions arrive already projected to PSX screen-pixel space -- the GTE does
; that on the CPU, same as the PC renderer's GTE_VERTEX_SHADER
; (platform/native_renderer.c). This shader's job is the screen-pixel ->
; clip-space remap (the "projection" uniform is an orthographic matrix, not a
; camera), plus rescaling texcoord/color from their packed integer vertex
; format back to the float range the old all-float vertex passed directly
; (docs/VERTEX_FORMAT_DESIGN.md, "Lever 2" -- PICA200 vertex fetch does not
; normalize GPU_SHORT/GPU_UNSIGNED_BYTE, so the raw integers must be scaled
; here, not on the CPU). No page/clut reaches the GPU at all -- texture
; resolution happens on the CPU before binding (see
; docs/CITRO3D_RENDERER_DESIGN.md, sections 1 and 6). No blending, no stereo
; eye offset yet -- both staged for later phases in the same doc.

; Uniforms
.fvec projection[4]

; Constants
.constf constants(0.0, 1.0, -1.0, 0.0)
.alias  zeros constants.xxxx
.alias  ones  constants.yyyy

; texcoordScale is 1/2048, NOT 1/N3DS_ATLAS_DIM: vertex UVs arrive as
; texel-CENTER numerators (2*texel + 1, see DrawTriangles) so the sampled
; coordinate is texel + 0.5 -- dead centre of the intended texel, where
; nearest-neighbour needs no boundary tie-break. (Session 16 correction: the
; previous 2*texel - 1 form cited PC's tcx=tcy=-1 vertices, but that PC code
; is commented out; sampling at texel - 0.5 put 1:1-mapped fragments -- font
; glyphs, sprites -- exactly ON texel boundaries, and at sub-page tile edges
; the tie-break crossed into the neighbouring 64x64 cache cell.)
.constf vertexScale(0.00048828125, 0.0039215686, 0.0, 0.0) ; 1/2048, 1/255
.alias  texcoordScale vertexScale.xxxx
.alias  colorScale    vertexScale.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs (regId order must match C3D_AttrInfo setup in native_renderer_3ds.c)
.alias inpos v0 ; x, y, z (z = emit-ordinal depth substrate, biased s16)
.alias intc  v1 ; u, v
.alias inclr v2 ; r, g, b, a

.proc main
	; x,y are 2D screen space (GTE already projected on the CPU). z is NOT a
	; camera-space depth: it is the emit-ordinal depth substrate (biased s16,
	; n3ds_backend.h N3DS_Vertex) and the ortho matrix spans its full range,
	; so nothing clips. With CTR_NATIVE_OT_DEPTH off the depth test is never
	; enabled and this value is inert. w=1.
	mov r0.xyz, inpos.xyz
	mov r0.w,  ones

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	; intc/inclr now carry raw unnormalized integers (GPU_SHORT / GPU_UNSIGNED_BYTE
	; fetch, see n3ds_backend.c) -- rescale here instead of on the CPU (design doc
	; finding 2/3). inclr only has 3 real fetched components (RGB, count=3 in
	; AttrInfo_AddLoader): do NOT read inclr.w, it is not a real value. Alpha is
	; a constant 1.0 instead.
	;
	; Constant operand goes FIRST (src1), input register SECOND (src2) --
	; verified empirically against picasso, not assumed: `mul outtc0.xy,
	; intc.xy, texcoordScale` (constant as src2) fails to assemble at all
	; ("invalid source2 register"), regardless of aliasing or destination
	; masking. PICA200's src2 operand cannot address the constant/uniform
	; bank, only src1 can -- swapping operand order is the fix, not a
	; workaround.
	mul outtc0.xy, texcoordScale, intc.xy
	; Real PICA200 only emits a vertex once EVERY component of EVERY declared
	; output register has been written; a partially-written output stalls the
	; shader unit forever, which wedges the whole command list -- the 2026-07-21
	; real-hardware boot hang (first draw-bearing frame never completed, next
	; C3D_FrameBegin(SYNCDRAW) waited forever). Emulators do not enforce this,
	; which is why Azahar rendered fine all along. outclr below already gets
	; the same full-write treatment (.xyz + .w); outtc0 was the one gap.
	mov outtc0.zw, zeros
	mul outclr.xyz, colorScale, inclr.xyz
	mov outclr.w, ones

	end
.end
