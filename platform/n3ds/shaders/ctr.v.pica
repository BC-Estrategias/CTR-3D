; CTR-Native PICA200 vertex shader -- phase 2a (static/opaque geometry, mono).
;
; Positions arrive already projected to PSX screen-pixel space -- the GTE does
; that on the CPU, same as the PC renderer's GTE_VERTEX_SHADER
; (platform/native_renderer.c). This shader's job is the screen-pixel ->
; clip-space remap (the "projection" uniform is an orthographic matrix, not a
; camera), plus rescaling texcoord/color from their packed integer vertex
; format back to the float range the old all-float vertex passed directly
; (docs/VERTEX_FORMAT_DESIGN.md, "Lever 2" -- PICA200 vertex fetch does not
; normalize GPU_SHORT/GPU_UNSIGNED_BYTE, so the raw integers must be scaled
; here, not on the CPU). No page/clut reaches the GPU at all -- texture
; resolution happens on the CPU before binding (see
; docs/CITRO3D_RENDERER_DESIGN.md, sections 1 and 6). No blending.
;
; STEREO (the "later phase" the original header deferred): each eye adds a
; per-vertex horizontal parallax p = k - kC/d, where d is the vertex's depth
; on the shared view.z axis. Packets recover d from their own depth stamp:
; z = 32767 - sz3 when the s29 packet-depth model is on (g_dbg_packetDepth,
; native_gpu.c), so d = 32767 - z IS sz3. When packet depth is OFF the stamp
; is an emit ordinal and d would be nonsense -- the CPU side handles that by
; sending a zero `stereo` uniform (N3DS_StereoEyeVec, n3ds_backend.c), which
; makes p identically 0 rather than gating in the shader. The near band
; (stamps 0xFFC0..0xFFFF = 2D/UI content, d < 64) always takes p = 0 via
; the mask below: HUD/menus sit at screen depth, which is both correct and
; the M2 3D-Classics convention.
;
; CHANNEL SPLIT (docs/FLAG_SPLIT_CHANNEL_SPEC.md): parallax reads inpos.W,
; not inpos.z. z is the OCCLUSION depth (what the PICA depth test compares);
; w is the PARALLAX depth (where the eye should place it). They are equal for
; all content except the menu/loading checkered flag, whose retail layering
; wants a per-pose occlusion answer while its wave needs one continuous
; stereo band -- one field could not say both. inpos.w is NOT a homogeneous
; w: the position's own w is forced to the constant 1.0 below, before the
; projection dp4s, so this value never divides anything.

; Uniforms
.fvec projection[4]
; Per-eye parallax, computed CPU-side per frame (n3ds_backend.c
; N3DS_StereoEyeVec): x = k (full shift at infinite depth, PSX px, signed
; per eye), y = k*convergence, z/w = clamp lo/hi for p. All zeros when the
; slider is down, the right target failed, or packet depth stamping is off.
; f4 -- and BOTH sibling programs park other uniforms on f4 (ctr_model's qx,
; ctr_track's projection row 1), so this must be re-uploaded on every return
; to packet state: N3DS_BindPacketDrawState does, same discipline as the
; projection rows above it (the s29 register-collision lesson).
.fvec stereo
; s44 UI POP-OUT. x = this eye's parallax for UI-band vertices, in PSX px,
; already signed per eye and already scaled by the slider (N3DS_StereoEyeVec).
; y/z/w unused.
;
; Owner's target: UI should sit "just barely popping out of the screen", not at
; it -- flat-zero was never the goal, it was what the mask happened to give.
; Applying it here (rather than shifting X on the CPU) is forced: the right eye
; is a journal REPLAY of the same vertex buffer, so anything per-eye has to be a
; uniform the shader reads.
;
; Lands on f5, which is qy in ctr_model.v.pica -- the s29 shared-register class.
; Safe because both sides re-upload on every bind: the model path writes qx/qy/qw
; per instance, and N3DS_BindPacketDrawState re-uploads this beside `stereo`.
; If you add another uniform here, verify that property again before trusting it.
.fvec stereoUi

; Constants
.constf constants(0.0, 1.0, -1.0, 0.0)
.alias  zeros constants.xxxx
.alias  ones  constants.yyyy
.alias  negOnes constants.zzzz

; Stereo constants. x = 32767 (depth stamp -> view.z axis: d = 32767 - z, the
; exact inverse of the packet side's z = 32767 - sz3 stamp). y = 63.5 -- the
; UI-band edge, strictly between the band's deepest world stamp (d = 64) and
; the band's own values (d <= 63); the slt against it is the "world content
; only" mask. Half-integer on purpose: both neighbours are exactly
; representable in float24 and neither can land ON the threshold.
.constf stereoConst(32767.0, 63.5, 0.0, 0.0)
.alias  stereoBias stereoConst.xxxx
.alias  uiBandEdge stereoConst.yyyy

; texcoordScale is 1/2048, NOT 1/N3DS_ATLAS_DIM: vertex UVs arrive as
; texel-CENTER numerators (2*texel + 1, see DrawTriangles) so the sampled
; coordinate is texel + 0.5 -- dead centre of the intended texel, where
; nearest-neighbour needs no boundary tie-break. (Session 16 correction: the
; previous 2*texel - 1 form cited PC's tcx=tcy=-1 vertices, but that PC code
; is commented out; sampling at texel - 0.5 put 1:1-mapped fragments -- font
; glyphs, sprites -- exactly ON texel boundaries, and at sub-page tile edges
; the tie-break crossed into the neighbouring 64x64 cache cell.)
.constf vertexScale(0.00048828125, 0.0039215686, 0.0, 0.0) ; 1/2048, 1/255
.alias  texcoordScale vertexScale.xxxx
.alias  colorScale    vertexScale.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs (regId order must match C3D_AttrInfo setup in native_renderer_3ds.c)
.alias inpos v0 ; x, y, z, w (z = occlusion depth substrate, w = parallax depth; both biased s16)
.alias intc  v1 ; u, v
.alias inclr v2 ; r, g, b, a

.proc main
	; x,y are 2D screen space (GTE already projected on the CPU). z is NOT a
	; camera-space depth: it is the emit-ordinal depth substrate (biased s16,
	; n3ds_backend.h N3DS_Vertex) and the ortho matrix spans its full range,
	; so nothing clips. With CTR_NATIVE_OT_DEPTH off the depth test is never
	; enabled and this value is inert. w=1.
	;
	; .xyz only: inpos.w is the parallax channel, and letting it reach r0.w
	; would feed it to the projection dp4s as a homogeneous divisor and warp
	; every vertex. The constant 1.0 below is what the projection needs.
	mov r0.xyz, inpos.xyz
	mov r0.w,  ones

	; ---- STEREO parallax (header comment) --------------------------------
	; d = 32767 - w (the PARALLAX channel, NOT r0.z -- see the channel-split
	; block in the header), clamped to >= 1 BEFORE the rcp: d can be exactly
	; 0 (a stamp of 0xFFFF), rcp(0) is inf, and inf * 0 from the mask
	; multiply is NaN -- which poisons the position instead of zeroing the
	; shift. The mask itself uses the UNCLAMPED d so the clamp cannot promote
	; a UI vertex into the world band. All uniform/constant operands ride
	; src1 (PICA200's src2 cannot address the constant bank -- see the mul
	; below). Read straight from inpos.w: r0.w already holds the constant 1.0
	; the projection needs, so the parallax depth is deliberately never
	; copied into r0.
	mul r1.x, negOnes, inpos.w          ; -w
	add r1.x, stereoBias, r1.x          ; d = 32767 - w
	slt r1.y, uiBandEdge, r1.x          ; mask = (d > 63.5) ? 1 : 0
	max r1.x, ones, r1.x                ; d >= 1, rcp stays finite
	rcp r1.z, r1.x                      ; 1/d
	mul r1.w, stereo.yyyy, r1.z         ; kC/d
	mul r1.w, negOnes, r1.w             ; -kC/d (no SUB opcode)
	add r1.w, stereo.xxxx, r1.w         ; p = k - kC/d
	max r1.w, stereo.zzzz, r1.w         ; p >= lo (pop-out clamp)
	min r1.w, stereo.wwww, r1.w         ; p <= hi
	mul r1.w, r1.y, r1.w                ; world keeps p; UI -> 0
	; s44: UI no longer stays at 0 -- it takes a small fixed pop-out instead.
	; invMask is 1 for UI and 0 for world, so world is untouched bit-for-bit and
	; the slider-down case is still identically 0 (stereoUi.x is 0 then).
	mul r1.y, negOnes, r1.y             ; -mask
	add r1.y, ones, r1.y                ; invMask = 1 - mask (1 for UI band)
	mul r1.y, stereoUi.xxxx, r1.y       ; UI pop-out, 0 for world
	add r1.w, r1.w, r1.y                ; p = world p, or the UI pop-out
	add r0.x, r0.x, r1.w                ; shifted screen X (both temps)

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	; intc/inclr now carry raw unnormalized integers (GPU_SHORT / GPU_UNSIGNED_BYTE
	; fetch, see n3ds_backend.c) -- rescale here instead of on the CPU (design doc
	; finding 2/3). inclr only has 3 real fetched components (RGB, count=3 in
	; AttrInfo_AddLoader): do NOT read inclr.w, it is not a real value. Alpha is
	; a constant 1.0 instead.
	;
	; Constant operand goes FIRST (src1), input register SECOND (src2) --
	; verified empirically against picasso, not assumed: `mul outtc0.xy,
	; intc.xy, texcoordScale` (constant as src2) fails to assemble at all
	; ("invalid source2 register"), regardless of aliasing or destination
	; masking. PICA200's src2 operand cannot address the constant/uniform
	; bank, only src1 can -- swapping operand order is the fix, not a
	; workaround.
	mul outtc0.xy, texcoordScale, intc.xy
	; Real PICA200 only emits a vertex once EVERY component of EVERY declared
	; output register has been written; a partially-written output stalls the
	; shader unit forever, which wedges the whole command list -- the 2026-07-21
	; real-hardware boot hang (first draw-bearing frame never completed, next
	; C3D_FrameBegin(SYNCDRAW) waited forever). Emulators do not enforce this,
	; which is why Azahar rendered fine all along. outclr below already gets
	; the same full-write treatment (.xyz + .w); outtc0 was the one gap.
	mov outtc0.zw, zeros
	mul outclr.xyz, colorScale, inclr.xyz
	mov outclr.w, ones

	end
.end
